# Reeve backend env. Copy to `.env` and fill in. pydantic-settings reads
# this file automatically; values can also come from the process env.

# ---- Stores ----------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=reeve

# ---- LLM provider ----------------------------------------------------------
# 'anthropic' (default) talks to api.anthropic.com using ANTHROPIC_API_KEY.
# 'bedrock'  talks to AWS Bedrock using the standard AWS credential chain
#            (env, profile, instance role). No API key needed.
LLM_PROVIDER=bedrock
AWS_BEDROCK_REGION=us-east-1

# When LLM_PROVIDER=anthropic, this is required.
# ANTHROPIC_API_KEY=

# When LLM_PROVIDER=bedrock, friendly model ids in agent specs are
# translated to Bedrock inference-profile ids. The defaults ship in
# `reeve/llm/client.py` (BEDROCK_DEFAULTS). Override per-model here as a
# JSON object — your Bedrock account may use different version-date suffixes.
# BEDROCK_MODEL_ALIASES={"claude-sonnet-4-6":"us.anthropic.claude-sonnet-4-6-20251029-v1:0","claude-opus-4-8":"us.anthropic.claude-opus-4-8-20251029-v1:0"}

# ---- Audit + proposals -----------------------------------------------------
# 'mongo' (local dev) or 'dynamo' (prod).
AUDIT_BACKEND=mongo
PROPOSALS_BACKEND=mongo
AWS_REGION=us-east-1

# ---- Categorizer -----------------------------------------------------------
# 'rules'   — regex only.
# 'cascade' — regex first; LLM fallback for rows the regex labels 'other'.
CATEGORIZER=cascade

# ---- Auth ------------------------------------------------------------------
# Change for any non-localhost deployment. Long random string (>= 32 bytes).
JWT_SECRET=reeve-dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=720
# PBKDF2-HMAC-SHA256 work factor. OWASP 2023 floor is 600000. Lower only
# for local testing.
PASSWORD_ITERATIONS=600000
# The id-based dev-token endpoint (/api/auth/login-by-id) is a backdoor —
# set to false in any shared/prod environment.
ENABLE_DEV_TOKEN=true
