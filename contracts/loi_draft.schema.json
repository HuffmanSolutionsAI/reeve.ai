{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reeve.ai/contracts/loi_draft.schema.json",
  "title": "loi_draft",
  "description": "Cole's letter-of-intent payload. While `pending`, this lives in the proposal record; on `executed`, the execution-layer handler writes it as an artifact and advances the deal to under_contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "address", "deal_id", "price", "addressee", "terms"],
  "properties": {
    "type": {"const": "loi_draft"},
    "deal_id": {"type": "string"},
    "address": {"type": "string"},
    "price": {"type": "number", "minimum": 0},
    "earnest_money": {"type": "number"},
    "due_diligence_days": {"type": "integer", "minimum": 0},
    "financing_contingency_days": {"type": "integer", "minimum": 0},
    "closing_days": {"type": "integer", "minimum": 0},
    "addressee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": {"type": "string"},
        "email": {"type": "string", "format": "email"},
        "role": {"type": "string"}
      }
    },
    "terms": {
      "type": "array",
      "items": {"type": "string"}
    },
    "narrative": {"type": "string"},
    "sent_at": {"type": "string"},
    "confidence": {"enum": ["high", "medium", "low"]}
  }
}
